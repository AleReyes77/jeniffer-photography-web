# ============================================================
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# ============================================================

# Entorno: development | production
NODE_ENV=production
# Puerto donde escucha el servidor (Render/Railway lo definen solos)
PORT=3000
# Dominio público del sitio, sin barra final
SITE_URL=https://TU-DOMINIO.com
# true si el sitio está detrás de un proxy (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=true

# Límite de reservas por IP: máximo RATE_LIMIT_MAX envíos cada RATE_LIMIT_WINDOW_MIN minutos
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=5

# Archivo donde se guardan las reservas (una línea JSON por reserva)
RESERVAS_FILE=data/reservas.jsonl

# ---- Correo (SMTP) para recibir cada reserva ----
# Ejemplo con Gmail: crea una "contraseña de aplicación" en tu cuenta de Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion
# Quién envía y quién recibe la notificación
CONTACT_FROM=tu-correo@gmail.com
CONTACT_TO=jenifferariana95@gmail.com

# ============================================================
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas el archivo .env a GitHub (está en .gitignore).
#  Hoy el sitio no necesita contraseñas: estas variables solo
#  ajustan cómo se ejecuta el servidor.
# ============================================================

# Entorno: development | production
NODE_ENV=production
# Puerto donde escucha el servidor (algunos hostings lo definen solos).
# Si tienes varios sitios en el mismo servidor, cada uno usa un puerto distinto (3000, 3001...).
PORT=3000
# Dirección de escucha: 127.0.0.1 = solo detrás de un proxy (recomendado). Docker usa 0.0.0.0
HOST=127.0.0.1
# Dominio público del sitio, sin barra final
SITE_URL=https://TU-DOMINIO.com
# true si el sitio está detrás de un proxy (Nginx, Apache, Cloudflare o el panel del hosting)
TRUST_PROXY=true
# Redirigir HTTP a HTTPS (por defecto: sí en producción con TRUST_PROXY=true)
FORCE_HTTPS=true

# Límite de peticiones por IP: máximo RATE_LIMIT_MAX cada RATE_LIMIT_WINDOW_SEC segundos
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300

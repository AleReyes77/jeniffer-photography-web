# ============================================================
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas el archivo .env a GitHub (está en .gitignore).
#  Hoy el sitio no necesita contraseñas: estas variables solo
#  ajustan cómo se ejecuta el servidor.
# ============================================================

# Entorno: development | production
NODE_ENV=production
# Puerto donde escucha el servidor (algunos hostings lo definen solos)
PORT=3000
# Dominio público del sitio, sin barra final
SITE_URL=https://TU-DOMINIO.com
# true si el sitio está detrás de un proxy (Nginx, Apache, Cloudflare o el panel del hosting)
TRUST_PROXY=true

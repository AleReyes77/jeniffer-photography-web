{
  "name": "jeniffer-photography-web",
  "version": "2.1.0",
  "private": true,
  "description": "Sitio web y servidor de Jeniffer Photography: portafolio de bodas, quinceaños y cumpleaños en Nicaragua, con reservas por WhatsApp.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start:env": "node --env-file=.env server/index.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "lint:html": "html-validate public/index.html public/404.html",
    "check:recursos": "node scripts/verificar-recursos.js",
    "verificar": "npm run lint:html && npm run check:recursos && npm test",
    "docs:pdf": "node scripts/documentacion/generar-pdf.js",
    "recursos": "node scripts/preparar-recursos.js",
    "docs:guia": "node scripts/documentacion/generar-guia.js"
  },
  "keywords": [
    "fotografia",
    "bodas",
    "quinceaños",
    "cumpleaños",
    "nicaragua",
    "portafolio",
    "express"
  ],
  "author": "Jeniffer Valle",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "bootstrap": "^5.3.2",
    "gsap": "^3.12.5",
    "html-validate": "^11.21.1",
    "purgecss": "^9.1.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.2",
    "three": "^0.128.0"
  }
}
